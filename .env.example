# Copy this file to .env and change the passwords before `make up`.
# `make env` does the copy for you.

# --- Cluster identity ---
CLUSTER_NAME=pxc-cluster

# --- Image versions ---
# The PXC image is built locally from docker/pxc/Dockerfile (Ubuntu 24.04 +
# Percona's apt repo). PXC_REPO selects which Percona repo to install from,
# e.g. pxc-84-lts (PXC 8.4, current LTS) or pxc-80 (PXC 8.0).
PXC_REPO=pxc-84-lts
# ProxySQL: pin to a "-debian" tagged release so every container in this lab
# runs on a Debian/Ubuntu base. Check https://hub.docker.com/r/proxysql/proxysql/tags
PROXYSQL_VERSION=2.6.3-debian

# --- MySQL root password (shared cluster-wide) ---
# SST (State Snapshot Transfer) credentials are generated automatically and
# per-request by PXC itself (PXC 8.0+) -- no wsrep_sst_auth to manage here.
MYSQL_ROOT_PASSWORD=ChangeMe_RootPW!

# --- Demo application database/user ---
MYSQL_DATABASE=demo
MYSQL_USER=appuser
MYSQL_PASSWORD=ChangeMe_AppPW!

# --- ProxySQL admin interface (port 6032) ---
# Must NOT be "admin"/"admin" -- that literal pair only ever works from
# 127.0.0.1, so the proxysql-init container (a different container) needs
# its own credentials to configure ProxySQL over the docker network.
PROXYSQL_ADMIN_USER=cluster_admin
PROXYSQL_ADMIN_PASSWORD=ChangeMe_ProxyAdminPW!

# --- ProxySQL -> PXC monitoring user ---
# Created on the PXC cluster during bootstrap; used by ProxySQL to poll
# wsrep status on each node so it can route traffic correctly.
PROXYSQL_MONITOR_USER=proxysql_monitor
PROXYSQL_MONITOR_PASSWORD=ChangeMe_MonitorPW!
